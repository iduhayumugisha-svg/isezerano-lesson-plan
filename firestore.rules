rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Only the authorized administrator (Custom Claims admin == true, verified administrator email, or active admin role)
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.admin == true) ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'twizerefelix90@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active')
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. Users Collection (Confidential: user directory restricted to owner or admin)
    match /users/{userId} {
      // Users can only read their own profile; Admin can read all for oversight
      allow read: if isOwner(userId) || isAdmin();

      // New users can create their own profile (defaults to teacher unless authorized admin)
      allow create: if isOwner(userId) && (
        (request.resource.data.role == 'teacher' && request.resource.data.status == 'active') ||
        isAdmin()
      );

      // Users can update their own non-sensitive profile fields; Admin can update all
      allow update: if (isOwner(userId) && 
        request.resource.data.role == resource.data.role && 
        request.resource.data.status == resource.data.status) || isAdmin();

      // Only Admin can delete user profiles
      allow delete: if isAdmin();
    }

    // 2. Application Configurable Settings (Curriculum & Platform Parameters)
    match /appSettings/{settingId} {
      // General curriculum settings can be read publicly without an account
      allow read: if true;

      // Only verified Admin can modify platform settings
      allow write: if isAdmin();
    }

    // 3. Lesson Plans Collection
    match /lesson_plans/{planId} {
      // Teachers read only their own plans; Admins can read all for oversight
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );

      // Create must bind ownerUid to caller
      allow create: if isAuthenticated() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );

      // Update and delete restricted to owner or admin
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // 4. Homepage Hero Slides
    match /homepage_slides/{slideId} {
      // Anyone (including ordinary website visitors) can read published slides
      allow read: if true;

      // Only the authorized administrator (twizerefelix90@gmail.com or verified admin role) can add, replace, delete, reorder, and publish photos
      allow write: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
