rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================
    // CORE AUTHENTICATION & AUTHORIZATION HELPERS
    // ==============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Must be authenticated via Google provider with email_verified == true
    function isGoogleAuth() {
      return isAuthenticated() &&
             request.auth.token.firebase.sign_in_provider == 'google.com' &&
             request.auth.token.email_verified == true;
    }

    // Strict single administrator: ONLY twizerefelix90@gmail.com with verified Google auth.
    // Custom claims (e.g. token.admin == true) are deliberately NOT accepted without the exact email.
    function isAdmin() {
      return isGoogleAuth() &&
             request.auth.token.email != null &&
             (
               request.auth.token.email == 'twizerefelix90@gmail.com' ||
               request.auth.token.email.matches('(?i)^twizerefelix90@gmail\\.com$')
             );
    }

    // Teacher ownership verification (must match authenticated Google UID)
    function isOwner(uid) {
      return isGoogleAuth() && request.auth.uid == uid;
    }

    // ==============================================================
    // 1. Users Collection (Confidential: restricted to owner or admin)
    // Protected against privilege escalation and unauthorized field injection
    // ==============================================================

    // Explicitly permitted fields for Teacher UserProfile documents
    function isAllowedUserKeys(keys) {
      return keys.hasOnly([
        'uid', 'email', 'displayName', 'role', 'status', 'schoolName', 'createdAt', 'updatedAt'
      ]);
    }

    function isSafeTeacherProfile(data, targetUid) {
      return isAllowedUserKeys(data.keys()) &&
             data.uid == targetUid &&
             data.role == 'teacher' &&
             (!('admin' in data)) &&
             (!('isAdmin' in data)) &&
             (!('permissions' in data)) &&
             (!('isSuperAdmin' in data));
    }

    match /users/{userId} {
      // Users can only read their own profile; Admin has global oversight
      allow read: if isOwner(userId) || isAdmin();

      // Teacher profile creation: strictly limited to allowed fields, role teacher, status active
      allow create: if (
        isOwner(userId) &&
        isSafeTeacherProfile(request.resource.data, userId) &&
        request.resource.data.status == 'active' &&
        request.resource.data.email == request.auth.token.email
      ) || isAdmin();

      // Teacher profile update: strictly limited to allowed fields; role and status cannot be modified
      allow update: if (
        isOwner(userId) &&
        isSafeTeacherProfile(request.resource.data, userId) &&
        request.resource.data.email == resource.data.email &&
        resource.data.role == 'teacher' &&
        request.resource.data.status == resource.data.status
      ) || isAdmin();

      // Only Admin can delete user profiles
      allow delete: if isAdmin();
    }

    // ==============================================================
    // 2. Application Configurable Settings (Curriculum & Platform Parameters)
    // ==============================================================
    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==============================================================
    // 3. Lesson Plans Collection (Authoritative ownerUid, No Conflicting IDs)
    // ==============================================================
    // Authoritative check: ownerUid must be present, match caller UID, and cannot conflict with userId
    function isLessonPlanCleanOwner(data) {
      return isGoogleAuth() &&
             ('ownerUid' in data) &&
             data.ownerUid is string &&
             data.ownerUid == request.auth.uid &&
             (!('userId' in data) || data.userId == request.auth.uid);
    }

    match /lesson_plans/{planId} {
      // Teachers can only read/delete their own authoritative records; ownerless/conflicting records are admin-only
      allow read, delete: if isLessonPlanCleanOwner(resource.data) || isAdmin();

      // On create, ownerUid must equal the caller's auth UID, and if userId is present it must also match
      allow create: if (
        isGoogleAuth() &&
        request.resource.data.ownerUid is string &&
        request.resource.data.ownerUid == request.auth.uid &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      ) || isAdmin();

      // On update, ownerUid cannot be transferred/modified by teachers; conflicting userId is rejected
      allow update: if (
        isLessonPlanCleanOwner(resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      ) || isAdmin();
    }

    // ==============================================================
    // 4. Homepage Hero Slides
    // ==============================================================
    match /homepage_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==============================================================
    // 5. Website Editable Pages (About Us, Contact Us, Privacy Policy, Terms & Conditions)
    // ==============================================================
    match /website_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==============================================================
    // 6. Shared Website Statistics and Activity Counters
    // ==============================================================
    match /site_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==============================================================
    // 7. News Platform: Posts with restricted view-counter increment (+1 only)
    // ==============================================================
    match /posts/{postId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Public visitors can only increment views by exactly +1 (or initialize to 1).
      // Note: Rules enforce +1 delta and restrict updates solely to the 'views' field.
      // Rules cannot perform stateful rate-limiting or prevent automated repetitive HTTP calls.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views is int && (
          (!('views' in resource.data) && request.resource.data.views == 1) ||
          ('views' in resource.data && request.resource.data.views == resource.data.views + 1)
        )
      );
    }

    // ==============================================================
    // 8. Site Settings & Branding
    // ==============================================================
    match /siteSettings/branding {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.logoData is string &&
        request.resource.data.logoData.size() <= 700000;
      allow delete: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==============================================================
    // 9. Preserved News Website Collections & Validated Comments
    // ==============================================================
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Validation for public blog comments:
    // Only permitted fields: name, content, postId, status, createdAt.
    // Commenters' emails and phone numbers are strictly prohibited from public comments
    // to ensure private personal info is never exposed to public reads.
    function isValidPublicComment(data) {
      return data.keys().hasOnly(['name', 'content', 'postId', 'createdAt', 'status']) &&
             data.name is string &&
             data.name.size() >= 2 &&
             data.name.size() <= 80 &&
             data.content is string &&
             data.content.size() >= 2 &&
             data.content.size() <= 2000 &&
             data.postId is string &&
             data.postId.size() > 0 &&
             data.postId.size() <= 120 &&
             (!('status' in data) || data.status == 'pending') &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60) || data.createdAt is timestamp);
    }

    match /comments/{commentId} {
      // Public visitors can ONLY read comments whose status is 'approved' AND which do not contain private email/phone.
      // Pending or rejected comments, or comments with private contact information, can ONLY be read by Admin.
      allow read: if (
        resource.data.status == 'approved' &&
        (!('email' in resource.data)) &&
        (!('phone' in resource.data))
      ) || isAdmin();

      // Legitimate public comment submission (status is pending or omitted, private email/phone fields strictly disallowed)
      allow create: if isValidPublicComment(request.resource.data) || isAdmin();

      // Moderation (approving, rejecting, updating status, editing, deleting) is administrator-only
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==============================================================
    // 10. NURSERY STUDENT REPORT CARD SYSTEM (N1, N2, N3)
    // Strict Google auth, verified email, private teacher records via ownerUid
    // ==============================================================

    function isValidNurseryStudent(data) {
      return data.fullName is string &&
             data.fullName.size() >= 2 &&
             data.fullName.size() <= 120 &&
             data.classGrade is string &&
             data.classGrade.size() >= 1 &&
             data.classGrade.size() <= 20 &&
             data.ownerUid is string &&
             data.ownerUid.size() > 0 &&
             (data.gender == 'Boy' || data.gender == 'Girl' || data.gender == 'Gabo' || data.gender == 'Gore') &&
             (!('registrationNumber' in data) || (data.registrationNumber is string && data.registrationNumber.size() <= 60)) &&
             (!('parentContact' in data) || (data.parentContact is string && data.parentContact.size() <= 60)) &&
             (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 20)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000));
    }

    // Validation for legacy general settings (does NOT require ownerUid)
    function isValidLegacyGeneralSettings(data) {
      return (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 120)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 80)) &&
             (!('sector' in data) || (data.sector is string && data.sector.size() <= 80)) &&
             (!('cell' in data) || (data.cell is string && data.cell.size() <= 80)) &&
             (!('village' in data) || (data.village is string && data.village.size() <= 80)) &&
             (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 20));
    }

    // Validation for per-teacher school settings (strictly requires ownerUid)
    function isValidTeacherSchoolSettings(data) {
      return data.ownerUid is string &&
             data.ownerUid.size() > 0 &&
             (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 120)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 80)) &&
             (!('sector' in data) || (data.sector is string && data.sector.size() <= 80)) &&
             (!('cell' in data) || (data.cell is string && data.cell.size() <= 80)) &&
             (!('village' in data) || (data.village is string && data.village.size() <= 80)) &&
             (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 20));
    }

    function isValidNurseryAssessment(data) {
      return data.studentId is string &&
             data.studentId.size() > 0 &&
             data.studentId.size() <= 120 &&
             data.ownerUid is string &&
             data.ownerUid.size() > 0 &&
             (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 20));
    }

    function studentBelongsToTeacher(studentId, teacherUid) {
      return exists(/databases/$(database)/documents/nursery_students/$(studentId)) &&
             get(/databases/$(database)/documents/nursery_students/$(studentId)).data.ownerUid == teacherUid;
    }

    // A. Nursery Students: Private per teacher via ownerUid; Admin has global oversight
    match /nursery_students/{studentId} {
      allow read, delete: if isOwner(resource.data.ownerUid) || isAdmin();

      allow create: if (isOwner(request.resource.data.ownerUid) || isAdmin()) &&
                       isValidNurseryStudent(request.resource.data);

      allow update: if (
        (isOwner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid) || 
        isAdmin()
      ) && isValidNurseryStudent(request.resource.data);
    }

    // B. Nursery School Settings:
    // Legacy 'general' school profile is strictly admin-only: completely denied to teachers
    // Teachers must only read, create, update, delete documents where ownerUid == request.auth.uid
    // Ownership cannot be changed by teachers.
    match /nursery_school_settings/{settingId} {
      allow read: if (settingId == 'general' && isAdmin()) ||
                     (settingId != 'general' && (isOwner(resource.data.ownerUid) || isAdmin()));

      allow create: if (settingId == 'general' && isAdmin() && isValidLegacyGeneralSettings(request.resource.data)) ||
                       (settingId != 'general' && (isOwner(request.resource.data.ownerUid) || isAdmin()) && isValidTeacherSchoolSettings(request.resource.data));

      allow update: if (
        (settingId == 'general' && isAdmin() && isValidLegacyGeneralSettings(request.resource.data)) ||
        (settingId != 'general' && (
          (isOwner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid) || 
          isAdmin()
        ) && isValidTeacherSchoolSettings(request.resource.data))
      );

      allow delete: if (settingId == 'general' && isAdmin()) ||
                       (settingId != 'general' && (isOwner(resource.data.ownerUid) || isAdmin()));
    }

    // C. Nursery Assessments:
    // Must belong to an existing student owned by the same teacher
    // Cannot be attached to another teacher's student. Ownership cannot be modified.
    match /nursery_assessments/{assessmentId} {
      allow read, delete: if isOwner(resource.data.ownerUid) || isAdmin();

      allow create: if (
        (
          isOwner(request.resource.data.ownerUid) &&
          studentBelongsToTeacher(request.resource.data.studentId, request.auth.uid) &&
          isValidNurseryAssessment(request.resource.data)
        ) ||
        (
          isAdmin() &&
          exists(/databases/$(database)/documents/nursery_students/$(request.resource.data.studentId)) &&
          isValidNurseryAssessment(request.resource.data)
        )
      );

      allow update: if (
        (
          isOwner(resource.data.ownerUid) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.studentId == resource.data.studentId &&
          studentBelongsToTeacher(resource.data.studentId, request.auth.uid) &&
          isValidNurseryAssessment(request.resource.data)
        ) ||
        (
          isAdmin() &&
          exists(/databases/$(database)/documents/nursery_students/$(request.resource.data.studentId)) &&
          isValidNurseryAssessment(request.resource.data)
        )
      );
    }

    // ==============================================================
    // 11. Default deny for all other documents
    // ==============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
