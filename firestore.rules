rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Only the authorized administrator (Custom Claims admin == true, or verified administrator email)
    // Avoids trusting user-controlled Firestore profile fields for administrative authorization
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.admin == true) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'twizerefelix90@gmail.com' ||
          request.auth.token.email.matches('(?i)^twizerefelix90@gmail\\.com$')
        ))
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. Users Collection (Confidential: user directory restricted to owner or admin)
    match /users/{userId} {
      // Users can only read their own profile; Admin can read all for oversight
      allow read: if isOwner(userId) || isAdmin();

      // New users can create their own profile (defaults to teacher unless authorized admin)
      allow create: if isOwner(userId) && (
        (request.resource.data.role == 'teacher' && request.resource.data.status == 'active') ||
        isAdmin()
      );

      // Users can update their own non-sensitive profile fields; Admin can update all
      allow update: if (isOwner(userId) && 
        request.resource.data.role == resource.data.role && 
        request.resource.data.status == resource.data.status) || isAdmin();

      // Only Admin can delete user profiles
      allow delete: if isAdmin();
    }

    // 2. Application Configurable Settings (Curriculum & Platform Parameters)
    match /appSettings/{settingId} {
      // General curriculum and design settings can be read publicly without an account
      allow read: if true;

      // Only verified Admin can modify platform settings
      allow write: if isAdmin();
    }

    // 3. Lesson Plans Collection
    match /lesson_plans/{planId} {
      // Teachers read only their own plans; Admins can read all for oversight
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );

      // Create must bind ownerUid to caller
      allow create: if isAuthenticated() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );

      // Update and delete restricted to owner or admin
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // 4. Homepage Hero Slides
    match /homepage_slides/{slideId} {
      // Anyone (including ordinary website visitors) can read published slides
      allow read: if true;

      // Only the authorized administrator can add, replace, delete, reorder, and publish photos
      allow write: if isAdmin();
    }

    // 5. Website Editable Pages (About Us, Contact Us, Privacy Policy, Terms & Conditions)
    match /website_pages/{pageId} {
      // Public visitors can read published content without signing in
      allow read: if true;

      // Only the explicitly authorized administrator can create, edit, publish, or delete page content
      allow write: if isAdmin();
    }

    // 6. Shared Website Statistics and Activity Counters
    match /site_stats/{statId} {
      // Anyone can read statistics counters
      allow read: if true;

      // Only administrator can modify or reset analytics counters (eliminates arbitrary user writes)
      allow write: if isAdmin();
    }

    // 7. News Platform: Posts with atomic view-counter increment support
    match /posts/{postId} {
      // Public (including unauthenticated visitors) can read news posts
      allow read: if true;

      // Only admin can create or delete posts
      allow create, delete: if isAdmin();

      // Admin can update all post fields; anonymous or non-admin visitors can only increment views with a valid non-decreasing integer
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views is int &&
        (!('views' in resource.data) || request.resource.data.views >= resource.data.views)
      );
    }

    // 8. Site Settings & Branding (Preserves exact logoData size validation for ISEZERANO NEWS)
    match /siteSettings/branding {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.logoData is string &&
        request.resource.data.logoData.size() <= 700000;
      allow delete: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Preserved News Website Collections
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Default deny for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
