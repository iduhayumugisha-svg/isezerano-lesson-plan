rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================
    // CORE AUTHENTICATION & AUTHORIZATION HELPERS
    // ==============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Must be authenticated via Google provider with email_verified == true
    function isGoogleAuth() {
      return isAuthenticated() &&
             request.auth.token.firebase.sign_in_provider == 'google.com' &&
             request.auth.token.email_verified == true;
    }

    // Strict single administrator: ONLY twizerefelix90@gmail.com with verified Google auth session.
    // Custom claims (e.g. token.admin == true) are deliberately NOT accepted without the verified email.
    function isAdmin() {
      return isGoogleAuth() &&
             request.auth.token.email != null &&
             (
               request.auth.token.email == 'twizerefelix90@gmail.com' ||
               request.auth.token.email.matches('(?i)^twizerefelix90@gmail\\.com$')
             );
    }

    // ==============================================================
    // 1. Admin Users Collection (Strictly Admin-Only)
    // ==============================================================
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // ==============================================================
    // 2. Application Settings (Explicit Allowlist — NO public wildcard reads)
    // ==============================================================
    // Public read (get only, no enumeration) strictly for public rendering settings:
    // - appSettings/ads (ad slots)
    // - appSettings/website_design (theme, branding, typography, WhatsApp contact)
    match /appSettings/ads {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    match /appSettings/website_design {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Admin FCM / push configuration is strictly Admin-only
    match /appSettings/fcm_config {
      allow read, write: if isAdmin();
    }

    // Any other or future appSettings documents are strictly Admin-only (fail-closed)
    match /appSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ==============================================================
    // 3. Site Settings & Branding (Explicit Allowlist — NO public wildcard reads)
    // ==============================================================
    match /siteSettings/branding {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.logoData is string &&
        request.resource.data.logoData.size() <= 700000;
      allow delete: if isAdmin();
    }

    match /siteSettings/blog_categories {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ==============================================================
    // 4. Shared Website Statistics and Activity Counters
    // ==============================================================
    match /site_stats/counters {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    match /site_stats/{statId} {
      allow read, write: if isAdmin();
    }

    // ==============================================================
    // 5. Public Website Content Collections (Public Read, Admin Write)
    // ==============================================================
    match /website_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Preserved legacy settings collection locked down to Admin-only
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ==============================================================
    // 6. News Platform: Posts with restricted view-counter increment (+1 only)
    // ==============================================================
    match /posts/{postId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Public visitors can only increment views by exactly +1 (or initialize to 1).
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views is int && (
          ((!('views' in resource.data) || resource.data.views == null) && request.resource.data.views == 1) ||
          ('views' in resource.data && resource.data.views is number && request.resource.data.views == resource.data.views + 1)
        )
      );
    }

    // ==============================================================
    // 7. Public Comments & Replies — Public/Private Separation + Author Ownership Protocol
    //
    // Security guarantees:
    // - Public /comments/{commentId} documents with `publicSafe == true` are enforced by rules
    //   on every create/update (including Admin writes) to contain ONLY the 10 approved public fields
    //   and NEVER email, phone, ownerToken, ownerSecret, ipAddress, or verifier.
    // - Public `list` queries MUST filter by `status in ['published', 'approved']` AND `publicSafe == true`,
    //   preventing un-migrated legacy documents containing inline PII from ever matching public queries.
    // - Private data (optional email & secret ownership tokens) lives exclusively in Admin-only subcollections
    //   (/comments/{commentId}/private/ownership and /comments/{commentId}/tokens/{tokenId}).
    // ==============================================================
    function isValidCommentId(id) {
      return id is string &&
             id.size() > 0 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasNoPrivateCommentFields(data) {
      return !('email' in data) &&
             !('phone' in data) &&
             !('ownerToken' in data) &&
             !('ownerSecret' in data) &&
             !('ipAddress' in data) &&
             !('verifier' in data);
    }

    function hasOnlyPublicCommentFields(data) {
      return data.keys().hasAll([
               'postId',
               'parentId',
               'replyToName',
               'name',
               'content',
               'status',
               'createdAt',
               'updatedAt',
               'edited',
               'publicSafe'
             ]) &&
             data.keys().hasOnly([
               'postId',
               'parentId',
               'replyToName',
               'name',
               'content',
               'status',
               'createdAt',
               'updatedAt',
               'edited',
               'publicSafe'
             ]) &&
             data.publicSafe == true &&
             hasNoPrivateCommentFields(data);
    }

    function isValidPublicCommentCreate(data) {
      return hasOnlyPublicCommentFields(data) &&
             data.postId is string &&
             data.postId.size() > 0 &&
             data.postId.size() <= 120 &&
             (
               data.parentId == null ||
               (
                 isValidCommentId(data.parentId) &&
                 exists(/databases/$(database)/documents/comments/$(data.parentId)) &&
                 get(/databases/$(database)/documents/comments/$(data.parentId)).data.postId == data.postId &&
                 get(/databases/$(database)/documents/comments/$(data.parentId)).data.status in ['published', 'approved'] &&
                 get(/databases/$(database)/documents/comments/$(data.parentId)).data.publicSafe == true
               )
             ) &&
             (
               (data.parentId == null && data.replyToName == null) ||
               (
                 data.parentId != null &&
                 (
                   data.replyToName == null ||
                   (data.replyToName is string && data.replyToName.size() >= 1 && data.replyToName.size() <= 80)
                 )
               )
             ) &&
             data.name is string &&
             data.name.size() >= 2 &&
             data.name.size() <= 80 &&
             data.content is string &&
             data.content.size() >= 2 &&
             data.content.size() <= 2000 &&
             data.status == 'published' &&
             data.createdAt is string &&
             data.createdAt.size() >= 10 &&
             data.createdAt.size() <= 60 &&
             data.updatedAt is string &&
             data.updatedAt == data.createdAt &&
             data.edited == false;
    }

    function hasValidCommentVerifier(commentId, verifier) {
      return verifier is string &&
             verifier.size() >= 37 &&
             verifier.size() <= 180 &&
             verifier.matches('^[a-fA-F0-9]{32,128}:[a-zA-Z0-9_\\-]{4,40}$') &&
             exists(/databases/$(database)/documents/comments/$(commentId)/tokens/$(verifier.split(':')[0]));
    }

    function isValidPublicCommentOwnerEdit(data, existingData, commentId) {
      return hasOnlyPublicCommentFields(data) &&
             data.diff(existingData).affectedKeys().hasOnly(['content', 'updatedAt', 'edited']) &&
             data.content is string &&
             data.content.size() >= 2 &&
             data.content.size() <= 2000 &&
             data.edited == true &&
             data.updatedAt is string &&
             data.updatedAt.size() >= 10 &&
             data.updatedAt.size() <= 60 &&
             data.updatedAt != existingData.updatedAt &&
             existingData.status in ['published', 'approved'] &&
             existingData.publicSafe == true &&
             exists(/databases/$(database)/documents/comments/$(commentId)/private/ownership) &&
             get(/databases/$(database)/documents/comments/$(commentId)/private/ownership).data.lastSyncedAt !=
               getAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership).data.lastSyncedAt &&
             getAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership).data.lastSyncedAt ==
               data.updatedAt;
    }

    match /comments/{commentId} {
      // Public visitors can ONLY read comments/replies that:
      // 1) are published (or legacy approved),
      // 2) carry the rule-enforced `publicSafe == true` schema guarantee, and
      // 3) contain ONLY the 10 approved public fields (verified on get, guaranteed by write rules for publicSafe docs).
      allow get: if isAdmin() || (
        resource != null &&
        resource.data.status in ['published', 'approved'] &&
        hasOnlyPublicCommentFields(resource.data)
      );
      allow list: if isAdmin() || (
        resource.data.status in ['published', 'approved'] &&
        resource.data.publicSafe == true
      );

      // Instant public comment/reply submission paired atomically with private ownership lock.
      // Even Admin writes cannot mark a document `publicSafe: true` if any private field is present.
      allow create: if (
        isAdmin() &&
        (!('publicSafe' in request.resource.data) || request.resource.data.publicSafe != true || hasOnlyPublicCommentFields(request.resource.data))
      ) || (
        isValidCommentId(commentId) &&
        isValidPublicCommentCreate(request.resource.data) &&
        !exists(/databases/$(database)/documents/comments/$(commentId)/private/ownership) &&
        existsAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership)
      );

      // Owners (proven via atomic batch against /private/ownership & /tokens) can edit ONLY content/updatedAt/edited;
      // Admin can moderate (hide/publish/reject) or edit any comment.
      allow update: if (
        isAdmin() &&
        (!('publicSafe' in request.resource.data) || request.resource.data.publicSafe != true || hasOnlyPublicCommentFields(request.resource.data))
      ) || isValidPublicCommentOwnerEdit(request.resource.data, resource.data, commentId);

      // Owners (proven via atomic batch against /private/ownership & /tokens) or Admin can delete comments.
      allow delete: if isAdmin() || (
        resource != null &&
        resource.data.status in ['published', 'approved'] &&
        exists(/databases/$(database)/documents/comments/$(commentId)/private/ownership) &&
        get(/databases/$(database)/documents/comments/$(commentId)/private/ownership).data.lastSyncedAt !=
          getAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership).data.lastSyncedAt &&
        get(/databases/$(database)/documents/comments/$(commentId)/private/ownership).data.verifier !=
          getAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership).data.verifier
      );

      // Cryptographic ownership tokens (Admin-only read/list/update/delete; public create ONLY atomically with a new comment)
      match /tokens/{tokenId} {
        allow read, update, delete: if isAdmin();
        allow create: if isAdmin() || (
          isValidCommentId(tokenId) &&
          tokenId.size() >= 32 &&
          tokenId.matches('^[a-fA-F0-9]{32,128}$') &&
          request.resource.data.keys().hasAll(['postId', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['postId', 'createdAt']) &&
          request.resource.data.postId is string &&
          request.resource.data.postId.size() > 0 &&
          request.resource.data.postId.size() <= 120 &&
          request.resource.data.createdAt is string &&
          request.resource.data.createdAt.size() <= 60 &&
          !exists(/databases/$(database)/documents/comments/$(commentId)) &&
          !exists(/databases/$(database)/documents/comments/$(commentId)/private/ownership) &&
          existsAfter(/databases/$(database)/documents/comments/$(commentId))
        );
      }

      // Private ownership metadata + optional visitor email (Admin-only read/delete; atomic create/update only)
      match /private/{ownershipId} {
        allow read, delete: if isAdmin();
        allow create: if isAdmin() || (
          ownershipId == 'ownership' &&
          request.resource.data.keys().hasAll(['postId', 'createdAt', 'lastSyncedAt', 'verifier']) &&
          request.resource.data.keys().hasOnly(['postId', 'createdAt', 'lastSyncedAt', 'verifier', 'email']) &&
          request.resource.data.postId is string &&
          request.resource.data.postId.size() > 0 &&
          request.resource.data.postId.size() <= 120 &&
          request.resource.data.createdAt is string &&
          request.resource.data.createdAt.size() <= 60 &&
          request.resource.data.lastSyncedAt == request.resource.data.createdAt &&
          request.resource.data.verifier == '' &&
          (!('email' in request.resource.data) || (
            request.resource.data.email is string &&
            request.resource.data.email.size() <= 160
          )) &&
          !exists(/databases/$(database)/documents/comments/$(commentId)) &&
          existsAfter(/databases/$(database)/documents/comments/$(commentId)) &&
          getAfter(/databases/$(database)/documents/comments/$(commentId)).data.postId == request.resource.data.postId
        );
        allow update: if isAdmin() || (
          ownershipId == 'ownership' &&
          exists(/databases/$(database)/documents/comments/$(commentId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verifier', 'lastSyncedAt']) &&
          request.resource.data.verifier != resource.data.verifier &&
          request.resource.data.lastSyncedAt is string &&
          request.resource.data.lastSyncedAt.size() >= 10 &&
          request.resource.data.lastSyncedAt.size() <= 80 &&
          request.resource.data.lastSyncedAt != resource.data.lastSyncedAt &&
          hasValidCommentVerifier(commentId, request.resource.data.verifier) &&
          (
            (!existsAfter(/databases/$(database)/documents/comments/$(commentId))) ||
            getAfter(/databases/$(database)/documents/comments/$(commentId)).data.updatedAt == request.resource.data.lastSyncedAt
          )
        );
      }
    }

    // ==============================================================
    // 8. Breaking News Announcements & Public Push Notification Subscriptions
    // ==============================================================
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isValidPublicFcmToken(data) {
      return data.id is string &&
             data.id.size() > 0 &&
             data.id.size() <= 128 &&
             data.token is string &&
             data.token.size() >= 10 &&
             data.token.size() <= 4096 &&
             (!('ownerUid' in data) || data.ownerUid == 'guest_device' || (isAuthenticated() && data.ownerUid == request.auth.uid));
    }

    match /fcm_tokens/{tokenId} {
      // Admin-only read/list/update/delete so visitor push tokens remain strictly confidential
      allow get, list, update, delete: if isAdmin();

      // Public readers can register a breaking news push subscription token without logging in
      allow create: if isAdmin() || isValidPublicFcmToken(request.resource.data);
    }

    // ==============================================================
    // 9. Fixed Mini Shop / Product Showcase
    //
    // Security guarantees:
    // - Public /mini_shop_products/{productId} documents are rule-enforced on every write
    //   to contain ONLY explicitly approved public showcase fields (`publicSafe == true` + 12 public fields).
    // - Private seller metadata / internal notes MUST live in /mini_shop_products/{productId}/private/{metaId}
    //   which is strictly Admin-only.
    // - Public visitors can ONLY read products where `active == true` AND `publicSafe == true`.
    // - Inactive or un-migrated products with extra fields are blocked from public reads.
    // ==============================================================
    function hasOnlyMiniShopPublicFields(data) {
      return data.keys().hasAll([
               'id',
               'title',
               'description',
               'imageUrl',
               'active',
               'displayOrder',
               'createdAt',
               'updatedAt',
               'publicSafe'
             ]) &&
             data.keys().hasOnly([
               'id',
               'title',
               'description',
               'price',
               'imageUrl',
               'imageStorageMode',
               'whatsappNumber',
               'phoneNumber',
               'active',
               'displayOrder',
               'createdAt',
               'updatedAt',
               'publicSafe'
             ]) &&
             data.publicSafe == true;
    }

    function isValidMiniShopProductWrite(data) {
      return hasOnlyMiniShopPublicFields(data) &&
             data.id is string &&
             data.id.size() > 0 &&
             data.id.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 2 &&
             data.title.size() <= 90 &&
             data.description is string &&
             data.description.size() >= 2 &&
             data.description.size() <= 200 &&
             (!('price' in data) || (data.price is string && data.price.size() <= 40)) &&
             data.imageUrl is string &&
             data.imageUrl.size() >= 5 &&
             data.imageUrl.size() <= 750000 &&
             (!('imageStorageMode' in data) || data.imageStorageMode in ['firebase_storage', 'firestore_embedded']) &&
             (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 30)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
             (('whatsappNumber' in data && data.whatsappNumber.size() > 0) || ('phoneNumber' in data && data.phoneNumber.size() > 0)) &&
             data.active is bool &&
             data.displayOrder is int &&
             data.displayOrder >= 0 &&
             data.createdAt is string &&
             data.createdAt.size() >= 10 &&
             data.createdAt.size() <= 60 &&
             data.updatedAt is string &&
             data.updatedAt.size() >= 10 &&
             data.updatedAt.size() <= 60;
    }

    match /mini_shop_products/{productId} {
      allow get: if isAdmin() || (
        resource != null &&
        resource.data.active == true &&
        hasOnlyMiniShopPublicFields(resource.data)
      );
      allow list: if isAdmin() || (
        resource.data.active == true &&
        resource.data.publicSafe == true
      );
      allow create, update: if isAdmin() && isValidMiniShopProductWrite(request.resource.data);
      allow delete: if isAdmin();

      // Admin-only private seller metadata, costs, supplier contacts, or internal notes
      match /private/{metaId} {
        allow read, write: if isAdmin();
      }
    }

    // ==============================================================
    // 10. Default deny for all other paths and removed legacy collections
    // ==============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
