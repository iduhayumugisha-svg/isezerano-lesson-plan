rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. Users Collection
    match /users/{userId} {
      // Authenticated users can read profiles
      allow read: if isAuthenticated();

      // New users can create their own profile, MUST have role 'teacher'
      allow create: if isOwner(userId) && 
        request.resource.data.role == 'teacher' &&
        request.resource.data.status == 'active';

      // Users can update their own non-sensitive profile fields (cannot escalate own role or unfreeze status)
      allow update: if (isOwner(userId) && 
        request.resource.data.role == resource.data.role && 
        request.resource.data.status == resource.data.status) || isAdmin();

      // Only Admin can delete user profiles
      allow delete: if isAdmin();
    }

    // 2. Application Configurable Settings
    match /appSettings/{settingId} {
      // All authenticated users can read the active curriculum, modules and settings
      allow read: if isAuthenticated();

      // Only verified Admin can modify platform settings
      allow write: if isAdmin();
    }

    // 3. Lesson Plans Collection
    match /lesson_plans/{planId} {
      // Teachers read only their own plans; Admins can read all for oversight
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );

      // Create must bind ownerUid to caller
      allow create: if isAuthenticated() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );

      // Update and delete restricted to owner or admin
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
