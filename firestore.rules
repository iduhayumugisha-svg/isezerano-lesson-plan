rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================
    // CORE AUTHENTICATION & AUTHORIZATION HELPERS
    // ==============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Must be authenticated via Google provider with email_verified == true
    function isGoogleAuth() {
      return isAuthenticated() &&
             request.auth.token.firebase.sign_in_provider == 'google.com' &&
             request.auth.token.email_verified == true;
    }

    // Strict single administrator: ONLY twizerefelix90@gmail.com with verified Google auth session.
    // Custom claims (e.g. token.admin == true) are deliberately NOT accepted without the verified email.
    function isAdmin() {
      return isGoogleAuth() &&
             request.auth.token.email != null &&
             (
               request.auth.token.email == 'twizerefelix90@gmail.com' ||
               request.auth.token.email.matches('(?i)^twizerefelix90@gmail\\.com$')
             );
    }

    // ==============================================================
    // 1. Admin Users Collection (Strictly Admin-Only)
    // ==============================================================
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // ==============================================================
    // 2. Application Settings (Explicit Allowlist — NO public wildcard reads)
    // ==============================================================
    // Public read (get only, no enumeration) strictly for public rendering settings:
    // - appSettings/ads (ad slots)
    // - appSettings/website_design (theme, branding, typography, WhatsApp contact)
    match /appSettings/ads {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    match /appSettings/website_design {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Admin FCM / push configuration is strictly Admin-only
    match /appSettings/fcm_config {
      allow read, write: if isAdmin();
    }

    // Any other or future appSettings documents are strictly Admin-only (fail-closed)
    match /appSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ==============================================================
    // 3. Site Settings & Branding (Explicit Allowlist — NO public wildcard reads)
    // ==============================================================
    match /siteSettings/branding {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.logoData is string &&
        request.resource.data.logoData.size() <= 700000;
      allow delete: if isAdmin();
    }

    match /siteSettings/blog_categories {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ==============================================================
    // 4. Shared Website Statistics and Activity Counters
    // ==============================================================
    match /site_stats/counters {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    match /site_stats/{statId} {
      allow read, write: if isAdmin();
    }

    // ==============================================================
    // 5. Public Website Content Collections (Public Read, Admin Write)
    // ==============================================================
    match /website_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Preserved legacy settings collection locked down to Admin-only
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ==============================================================
    // 6. News Platform: Posts with restricted view-counter increment (+1 only)
    // ==============================================================
    match /posts/{postId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Public visitors can only increment views by exactly +1 (or initialize to 1).
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views is int && (
          ((!('views' in resource.data) || resource.data.views == null) && request.resource.data.views == 1) ||
          ('views' in resource.data && resource.data.views is number && request.resource.data.views == resource.data.views + 1)
        )
      );
    }

    // ==============================================================
    // 7. Public Comments & Replies — Public/Private Separation + Author Ownership Protocol
    //
    // Security guarantees:
    // - Public /comments/{commentId} documents with `publicSafe == true` are enforced by rules
    //   on every create/update (including Admin writes) to contain ONLY the 10 approved public fields
    //   and NEVER email, phone, ownerToken, ownerSecret, ipAddress, or verifier.
    // - Public `list` queries MUST filter by `status in ['published', 'approved']` AND `publicSafe == true`,
    //   preventing un-migrated legacy documents containing inline PII from ever matching public queries.
    // - Private data (optional email & secret ownership tokens) lives exclusively in Admin-only subcollections
    //   (/comments/{commentId}/private/ownership and /comments/{commentId}/tokens/{tokenId}).
    // ==============================================================
    function isValidCommentId(id) {
      return id is string &&
             id.size() > 0 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_-]+$');
    }

    function hasNoPrivateCommentFields(data) {
      return !('email' in data) &&
             !('phone' in data) &&
             !('ownerToken' in data) &&
             !('ownerSecret' in data) &&
             !('ipAddress' in data) &&
             !('verifier' in data);
    }

    function hasOnlyPublicCommentFields(data) {
      return data.keys().hasOnly([
               'postId',
               'parentId',
               'replyToName',
               'name',
               'content',
               'status',
               'createdAt',
               'updatedAt',
               'edited',
               'publicSafe'
             ]) &&
             data.publicSafe == true;
    }

    function hasRequiredPublicCommentFields(data) {
      return hasOnlyPublicCommentFields(data) &&
             data.keys().hasAll([
               'postId',
               'parentId',
               'replyToName',
               'name',
               'content',
               'status',
               'createdAt',
               'updatedAt',
               'edited',
               'publicSafe'
             ]) &&
             hasNoPrivateCommentFields(data);
    }

    // Must ONLY be called after verifying isValidCommentId(data.parentId) && exists(.../comments/$(data.parentId))
    function hasValidParentComment(data) {
      let parent = get(/databases/$(database)/documents/comments/$(data.parentId));
      return parent != null &&
             parent.data.postId == data.postId &&
             parent.data.status in ['published', 'approved'] &&
             parent.data.publicSafe == true;
    }

    function isValidPublicCommentCreate(data) {
      return hasRequiredPublicCommentFields(data) &&
             data.postId is string &&
             data.postId.size() > 0 &&
             data.postId.size() <= 120 &&
             (
               data.parentId == null ||
               (
                 isValidCommentId(data.parentId) &&
                 exists(/databases/$(database)/documents/comments/$(data.parentId)) &&
                 hasValidParentComment(data)
               )
             ) &&
             (
               (data.parentId == null && data.replyToName == null) ||
               (
                 data.parentId != null &&
                 (
                   data.replyToName == null ||
                   (data.replyToName is string && data.replyToName.size() >= 1 && data.replyToName.size() <= 80)
                 )
               )
             ) &&
             data.name is string &&
             data.name.size() >= 2 &&
             data.name.size() <= 80 &&
             data.content is string &&
             data.content.size() >= 2 &&
             data.content.size() <= 2000 &&
             data.status == 'published' &&
             data.createdAt is string &&
             data.createdAt.size() >= 10 &&
             data.createdAt.size() <= 60 &&
             data.updatedAt is string &&
             data.updatedAt == data.createdAt &&
             data.edited == false;
    }

    // Must ONLY be called after verifying existsAfter(.../private/ownership)
    function hasValidOwnershipAfterForComment(commentId, data) {
      let ownershipAfter = getAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership);
      return ownershipAfter != null &&
             ownershipAfter.data.tokenHash is string &&
             ownershipAfter.data.tokenHash.matches('^[a-f0-9]{64}$') &&
             ownershipAfter.data.postId == data.postId &&
             ownershipAfter.data.createdAt == data.createdAt;
    }

    // Must ONLY be called after verifying existsAfter(.../private/ownership)
    function hasValidOwnershipAfterForToken(commentId, tokenId, data) {
      let ownershipAfter = getAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership);
      return ownershipAfter != null &&
             ownershipAfter.data.tokenHash == tokenId &&
             ownershipAfter.data.postId == data.postId &&
             ownershipAfter.data.createdAt == data.createdAt;
    }

    // Acyclic existence check: private/ownership verifies both peer documents exist in the atomic batch
    // without triggering circular getAfter evaluations back onto /comments and /tokens.
    function hasValidPeerDocsAfterForOwnership(commentId, data) {
      return existsAfter(/databases/$(database)/documents/comments/$(commentId)) &&
             existsAfter(/databases/$(database)/documents/comments/$(commentId)/tokens/$(data.tokenHash));
    }

    function sha256LowerHex(value) {
      return hashing.sha256(value.toUtf8()).toHexString().lower();
    }

    function isValidVerifierFormat(verifier, syncedAt) {
      return verifier is string &&
             verifier.size() >= 97 &&
             verifier.size() <= 193 &&
             verifier.matches('^[a-fA-F0-9]{32,128}:[a-f0-9]{64}$') &&
             syncedAt is string &&
             syncedAt.size() >= 10;
    }

    // Must ONLY be called after verifying exists(.../tokens/$(expectedHash))
    function hasValidCommentTokenDoc(commentId, expectedHash, rawToken, actionProof, commentData, syncedAt) {
      let tokenDoc = get(/databases/$(database)/documents/comments/$(commentId)/tokens/$(expectedHash));
      return tokenDoc != null &&
             tokenDoc.data.tokenHash == expectedHash &&
             tokenDoc.data.postId == commentData.postId &&
             tokenDoc.data.createdAt == commentData.createdAt &&
             actionProof ==
               sha256LowerHex(
                 rawToken + ':' + commentData.postId + ':' + commentData.createdAt + ':' + syncedAt
               );
    }

    // Must ONLY be called after verifying isValidVerifierFormat(verifier, syncedAt) && ownershipDoc != null
    function hasValidCommentVerifierProof(commentId, verifier, commentData, syncedAt, ownershipDoc) {
      let tokenParts = verifier.split(':');
      let rawToken = tokenParts[0];
      let expectedHash = sha256LowerHex(rawToken);
      return tokenParts.size() == 2 &&
             ownershipDoc.data.tokenHash == expectedHash &&
             exists(/databases/$(database)/documents/comments/$(commentId)/tokens/$(expectedHash)) &&
             hasValidCommentTokenDoc(
               commentId,
               expectedHash,
               rawToken,
               tokenParts[1],
               commentData,
               syncedAt
             );
    }

    // Must ONLY be called after verifying exists(.../private/ownership) && existsAfter(.../private/ownership)
    function isValidPublicCommentOwnerEdit(data, existingData, commentId) {
      let ownershipBefore = get(/databases/$(database)/documents/comments/$(commentId)/private/ownership);
      let ownershipAfter = getAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership);
      return hasRequiredPublicCommentFields(data) &&
             data.diff(existingData).affectedKeys().hasOnly(['content', 'updatedAt', 'edited']) &&
             data.content is string &&
             data.content.size() >= 2 &&
             data.content.size() <= 2000 &&
             data.edited == true &&
             data.updatedAt is string &&
             data.updatedAt.size() >= 10 &&
             data.updatedAt.size() <= 60 &&
             data.updatedAt != existingData.updatedAt &&
             existingData.status in ['published', 'approved'] &&
             existingData.publicSafe == true &&
             ownershipBefore != null &&
             ownershipAfter != null &&
             ownershipBefore.data.postId == existingData.postId &&
             ownershipBefore.data.lastSyncedAt != ownershipAfter.data.lastSyncedAt &&
             ownershipBefore.data.verifier != ownershipAfter.data.verifier &&
             ownershipAfter.data.lastSyncedAt == data.updatedAt &&
             isValidVerifierFormat(ownershipAfter.data.verifier, data.updatedAt) &&
             hasValidCommentVerifierProof(
               commentId,
               ownershipAfter.data.verifier,
               existingData,
               data.updatedAt,
               ownershipBefore
             );
    }

    // Must ONLY be called after verifying exists(.../private/ownership) && existsAfter(.../private/ownership)
    function isValidPublicCommentOwnerDelete(existingData, commentId) {
      let ownershipBefore = get(/databases/$(database)/documents/comments/$(commentId)/private/ownership);
      let ownershipAfter = getAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership);
      return existingData.status in ['published', 'approved'] &&
             ownershipBefore != null &&
             ownershipAfter != null &&
             ownershipBefore.data.postId == existingData.postId &&
             ownershipBefore.data.lastSyncedAt != ownershipAfter.data.lastSyncedAt &&
             ownershipBefore.data.verifier != ownershipAfter.data.verifier &&
             isValidVerifierFormat(ownershipAfter.data.verifier, ownershipAfter.data.lastSyncedAt) &&
             hasValidCommentVerifierProof(
               commentId,
               ownershipAfter.data.verifier,
               existingData,
               ownershipAfter.data.lastSyncedAt,
               ownershipBefore
             );
    }

    // Must ONLY be called after verifying exists(/databases/$(database)/documents/comments/$(commentId))
    function isValidPublicOwnershipUpdate(commentId, newData, existingData) {
      let commentDoc = get(/databases/$(database)/documents/comments/$(commentId));
      return commentDoc != null &&
             existingData.postId == commentDoc.data.postId &&
             existingData.createdAt == commentDoc.data.createdAt &&
             newData.diff(existingData).affectedKeys().hasOnly(['verifier', 'lastSyncedAt']) &&
             newData.verifier != existingData.verifier &&
             newData.lastSyncedAt is string &&
             newData.lastSyncedAt.size() >= 10 &&
             newData.lastSyncedAt.size() <= 80 &&
             newData.lastSyncedAt != existingData.lastSyncedAt &&
             isValidVerifierFormat(newData.verifier, newData.lastSyncedAt) &&
             hasValidCommentVerifierProof(
               commentId,
               newData.verifier,
               commentDoc.data,
               newData.lastSyncedAt,
               resource
             ) &&
             (
               !existsAfter(/databases/$(database)/documents/comments/$(commentId)) ||
               getAfter(/databases/$(database)/documents/comments/$(commentId)).data.updatedAt == newData.lastSyncedAt
             );
    }

    match /comments/{commentId} {
      // Public visitors can ONLY read comments/replies that:
      // 1) are published (or legacy approved),
      // 2) carry the rule-enforced `publicSafe == true` schema guarantee, and
      // 3) contain ONLY the 10 approved public fields.
      allow get: if isAdmin() || (
        resource != null &&
        resource.data.status in ['published', 'approved'] &&
        hasRequiredPublicCommentFields(resource.data)
      );
      allow list: if isAdmin() || (
        resource.data.status in ['published', 'approved'] &&
        hasOnlyPublicCommentFields(resource.data)
      );

      // Instant public comment/reply submission paired atomically with BOTH /private/ownership AND /tokens/{tokenHash}.
      // Even Admin writes cannot mark a document `publicSafe: true` if any private field is present.
      allow create: if (
        isAdmin() &&
        (!('publicSafe' in request.resource.data) || request.resource.data.publicSafe != true || hasRequiredPublicCommentFields(request.resource.data))
      ) || (
        isValidCommentId(commentId) &&
        isValidPublicCommentCreate(request.resource.data) &&
        !exists(/databases/$(database)/documents/comments/$(commentId)/private/ownership) &&
        existsAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership) &&
        hasValidOwnershipAfterForComment(commentId, request.resource.data)
      );

      // Owners (proven via atomic batch against /private/ownership & /tokens) can edit ONLY content/updatedAt/edited;
      // Admin can moderate (hide/publish/reject) or edit any comment.
      allow update: if (
        isAdmin() &&
        (!('publicSafe' in request.resource.data) || request.resource.data.publicSafe != true || hasRequiredPublicCommentFields(request.resource.data))
      ) || (
        resource != null &&
        exists(/databases/$(database)/documents/comments/$(commentId)/private/ownership) &&
        existsAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership) &&
        isValidPublicCommentOwnerEdit(request.resource.data, resource.data, commentId)
      );

      // Owners (proven via atomic batch against /private/ownership & /tokens) or Admin can delete comments.
      allow delete: if isAdmin() || (
        resource != null &&
        exists(/databases/$(database)/documents/comments/$(commentId)/private/ownership) &&
        existsAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership) &&
        isValidPublicCommentOwnerDelete(resource.data, commentId)
      );

      // Cryptographic ownership tokens (Admin-only read/list/update/delete; public create ONLY atomically with a new comment & ownership)
      match /tokens/{tokenId} {
        allow read, update, delete: if isAdmin();
        allow create: if isAdmin() || (
          isValidCommentId(tokenId) &&
          tokenId.size() == 64 &&
          tokenId.matches('^[a-f0-9]{64}$') &&
          request.resource.data.keys().hasAll(['tokenHash', 'postId', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['tokenHash', 'postId', 'createdAt']) &&
          request.resource.data.tokenHash == tokenId &&
          request.resource.data.postId is string &&
          request.resource.data.postId.size() > 0 &&
          request.resource.data.postId.size() <= 120 &&
          request.resource.data.createdAt is string &&
          request.resource.data.createdAt.size() >= 10 &&
          request.resource.data.createdAt.size() <= 60 &&
          !exists(/databases/$(database)/documents/comments/$(commentId)) &&
          existsAfter(/databases/$(database)/documents/comments/$(commentId)/private/ownership) &&
          hasValidOwnershipAfterForToken(commentId, tokenId, request.resource.data)
        );
      }

      // Private ownership metadata + optional visitor email (Admin-only read/delete; atomic create/update only)
      match /private/{ownershipId} {
        allow read, delete: if isAdmin();
        allow create: if isAdmin() || (
          ownershipId == 'ownership' &&
          request.resource.data.keys().hasAll(['tokenHash', 'postId', 'createdAt', 'lastSyncedAt', 'verifier']) &&
          request.resource.data.keys().hasOnly(['tokenHash', 'postId', 'createdAt', 'lastSyncedAt', 'verifier', 'email']) &&
          request.resource.data.tokenHash is string &&
          request.resource.data.tokenHash.matches('^[a-f0-9]{64}$') &&
          request.resource.data.postId is string &&
          request.resource.data.postId.size() > 0 &&
          request.resource.data.postId.size() <= 120 &&
          request.resource.data.createdAt is string &&
          request.resource.data.createdAt.size() >= 10 &&
          request.resource.data.createdAt.size() <= 60 &&
          request.resource.data.lastSyncedAt == request.resource.data.createdAt &&
          request.resource.data.verifier == '' &&
          (!('email' in request.resource.data) || (
            request.resource.data.email is string &&
            request.resource.data.email.size() <= 160
          )) &&
          !exists(/databases/$(database)/documents/comments/$(commentId)) &&
          hasValidPeerDocsAfterForOwnership(commentId, request.resource.data)
        );
        allow update: if isAdmin() || (
          ownershipId == 'ownership' &&
          resource != null &&
          exists(/databases/$(database)/documents/comments/$(commentId)) &&
          isValidPublicOwnershipUpdate(commentId, request.resource.data, resource.data)
        );
      }
    }

    // ==============================================================
    // 8. Breaking News Announcements & Public Push Notification Subscriptions
    // ==============================================================
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isValidPublicFcmToken(data) {
      return data.id is string &&
             data.id.size() > 0 &&
             data.id.size() <= 128 &&
             data.token is string &&
             data.token.size() >= 10 &&
             data.token.size() <= 4096 &&
             (!('ownerUid' in data) || data.ownerUid == 'guest_device' || (isAuthenticated() && data.ownerUid == request.auth.uid));
    }

    match /fcm_tokens/{tokenId} {
      // Admin-only read/list/update/delete so visitor push tokens remain strictly confidential
      allow get, list, update, delete: if isAdmin();

      // Public readers can register a breaking news push subscription token without logging in
      allow create: if isAdmin() || isValidPublicFcmToken(request.resource.data);
    }

    // ==============================================================
    // 9. Default deny for all other paths and removed legacy collections
    // ==============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
