rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isGoogleAuth() {
      return isAuthenticated() &&
             request.auth.token.firebase.sign_in_provider == 'google.com' &&
             request.auth.token.email_verified == true;
    }

    // Strict single administrator: ONLY verified Google login for twizerefelix90@gmail.com
    function isAdmin() {
      return isGoogleAuth() &&
             request.auth.token.email != null &&
             (
               request.auth.token.email == 'twizerefelix90@gmail.com' ||
               request.auth.token.email.matches('(?i)^twizerefelix90@gmail\\.com$')
             );
    }

    // Publicly viewable homepage photos (Max 15MB, Images only, Admin upload only)
    match /homepage_photos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Publicly viewable website assets and branding logos (Max 10MB, Images only, Admin upload only)
    match /website_assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Preserved news website storage collections (posts, news, logos — Admin upload only)
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /news/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
