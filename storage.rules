rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.admin == true) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'twizerefelix90@gmail.com' ||
          request.auth.token.email.matches('(?i)^twizerefelix90@gmail\\.com$')
        ))
      );
    }

    // Publicly viewable homepage photos (Max 10MB, Images only)
    match /homepage_photos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && 
        request.resource.size < 10 * 1024 * 1024 && 
        request.resource.contentType.matches('image/.*');
    }

    // Publicly viewable website assets and branding logos (Max 5MB, Images only)
    match /website_assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && 
        request.resource.size < 5 * 1024 * 1024 && 
        request.resource.contentType.matches('image/.*');
    }

    // Preserved news website storage collections (posts, news, logos)
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && 
        request.resource.size < 10 * 1024 * 1024 && 
        request.resource.contentType.matches('image/.*');
    }

    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && 
        request.resource.size < 5 * 1024 * 1024 && 
        request.resource.contentType.matches('image/.*');
    }

    match /news/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && 
        request.resource.size < 10 * 1024 * 1024 && 
        request.resource.contentType.matches('image/.*');
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
